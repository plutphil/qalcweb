<QALCULATE version="3.19.0">
  <prefix type="decimal">
    <names>ar:q,r:quecto</names>
    <exponent>-30</exponent>
  </prefix>
  <prefix type="decimal">
    <names>ar:r,r:ronto</names>
    <exponent>-27</exponent>
  </prefix>
  <prefix type="decimal">
    <names>ar:y,r:yocto</names>
    <exponent>-24</exponent>
  </prefix>
  <prefix type="decimal">
    <names>ar:z,r:zepto</names>
    <exponent>-21</exponent>
  </prefix>
  <prefix type="decimal">
    <names>ar:a,r:atto</names>
    <exponent>-18</exponent>
  </prefix>
  <prefix type="decimal">
    <names>ar:f,r:femto</names>
    <exponent>-15</exponent>
  </prefix>
  <prefix type="decimal">
    <names>ar:p,r:pico</names>
    <exponent>-12</exponent>
  </prefix>
  <prefix type="decimal">
    <names>ar:n,r:nano</names>
    <exponent>-9</exponent>
  </prefix>
  <prefix type="decimal">
    <names>aur:μ,auor:µ,ar:u,r:micro</names>
    <exponent>-6</exponent>
  </prefix>
  <prefix type="decimal">
    <names>ar:m,r:milli</names>
    <exponent>-3</exponent>
  </prefix>
  <prefix type="decimal">
    <names>ar:c,r:centi</names>
    <exponent>-2</exponent>
  </prefix>
  <prefix type="decimal">
    <names>ar:d,r:deci</names>
    <exponent>-1</exponent>
  </prefix>
  <prefix type="decimal">
    <names>ar:da,r:deca</names>
    <exponent>1</exponent>
  </prefix>
  <prefix type="decimal">
    <names>ar:h,r:hecto</names>
    <exponent>2</exponent>
  </prefix>
  <prefix type="decimal">
    <names>ar:k,r:kilo</names>
    <exponent>3</exponent>
  </prefix>
  <prefix type="decimal">
    <names>ar:M,r:mega</names>
    <exponent>6</exponent>
  </prefix>
  <prefix type="decimal">
    <names>ar:G,r:giga</names>
    <exponent>9</exponent>
  </prefix>
  <prefix type="decimal">
    <names>ar:T,r:tera</names>
    <exponent>12</exponent>
  </prefix>
  <prefix type="decimal">
    <names>ar:P,r:peta</names>
    <exponent>15</exponent>
  </prefix>
  <prefix type="decimal">
    <names>ar:E,r:exa</names>
    <exponent>18</exponent>
  </prefix>
  <prefix type="decimal">
    <names>ar:Z,r:zetta</names>
    <exponent>21</exponent>
  </prefix>
  <prefix type="decimal">
    <names>ar:Y,r:yotta</names>
    <exponent>24</exponent>
  </prefix>
  <prefix type="decimal">
    <names>ar:R,r:ronna</names>
    <exponent>27</exponent>
  </prefix>
  <prefix type="decimal">
    <names>ar:Q,r:quetta</names>
    <exponent>30</exponent>
  </prefix>
  <prefix type="binary">
    <names>ar:Ki,r:kibi</names>
    <exponent>10</exponent>
  </prefix>
  <prefix type="binary">
    <names>ar:Mi,r:mebi</names>
    <exponent>20</exponent>
  </prefix>
  <prefix type="binary">
    <names>ar:Gi,r:gibi</names>
    <exponent>30</exponent>
  </prefix>
  <prefix type="binary">
    <names>ar:Ti,r:tebi</names>
    <exponent>40</exponent>
  </prefix>
  <prefix type="binary">
    <names>ar:Pi,r:pebi</names>
    <exponent>50</exponent>
  </prefix>
  <prefix type="binary">
    <names>ar:Ei,r:exbi</names>
    <exponent>60</exponent>
  </prefix>
  <prefix type="binary">
    <names>ar:Zi,r:zebi</names>
    <exponent>70</exponent>
  </prefix>
  <prefix type="binary">
    <names>ar:Yi,r:yobi</names>
    <exponent>80</exponent>
  </prefix>
  <prefix type="binary">
    <names>ar:Ri,r:robi</names>
    <exponent>90</exponent>
  </prefix>
  <prefix type="binary">
    <names>ar:Qi,r:quebi</names>
    <exponent>100</exponent>
  </prefix>
</QALCULATE>
<?xml version="1.0" encoding="utf-8"?>
<QALCULATE version="5.7.0">
  <category>
    <!-- Unit category -->
    <title>!units!Length</title>
    <unit type="base">
      <system>SI</system>
      <title>Meter</title>
      <names>ar:m,meter,p:meters,metre,p:metres</names>
      <use_with_prefixes max="3">true</use_with_prefixes>
    </unit>
    <unit type="composite">
      <title>Kilometer</title>
      <names translatable="no">r:km_c</names>
      <part>
        <unit>m</unit>
        <prefix>3</prefix>
        <exponent>1</exponent>
      </part>
    </unit>
    <unit type="composite">
      <title>Decimeter</title>
      <names translatable="no">r:dm_c</names>
      <part>
        <unit>m</unit>
        <prefix>-1</prefix>
        <exponent>1</exponent>
      </part>
    </unit>
    <unit type="composite">
      <title>Centimeter</title>
      <names translatable="no">r:cm_c</names>
      <part>
        <unit>m</unit>
        <prefix>-2</prefix>
        <exponent>1</exponent>
      </part>
    </unit>
    <unit type="composite">
      <title>Millimeter</title>
      <names translatable="no">r:mm_c</names>
      <part>
        <unit>m</unit>
        <prefix>-3</prefix>
        <exponent>1</exponent>
      </part>
    </unit>
    <unit type="composite">
      <title>Micrometer</title>
      <names translatable="no">r:um_c</names>
      <part>
        <unit>m</unit>
        <prefix>-6</prefix>
        <exponent>1</exponent>
      </part>
    </unit>
    <unit type="composite">
      <title>Nanometer</title>
      <names translatable="no">r:nm_c</names>
      <part>
        <unit>m</unit>
        <prefix>-9</prefix>
        <exponent>1</exponent>
      </part>
    </unit>
    <unit type="alias">
      <title>Micron</title>
      <names>r:micron,p:microns</names>
      <base>
        <unit>um_c</unit>
        <relation>1</relation>
        <exponent>1</exponent>
        <mix>-1</mix>
      </base>
    </unit>
    <unit type="alias">
      <title>Nautical Mile</title>
      <names>r:nautical_mile,p:nautical_miles,a:nmi</names>
      <base>
        <unit>m</unit>
        <relation>1852</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>Ångström</title>
      <names>aru:Å,aou:Å,u:ångström,angstrom</names>
      <use_with_prefixes>true</use_with_prefixes>
      <base>
        <unit>m</unit>
        <relation>1E-10</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>U.S. Survey Inch</title>
      <system>US Survey</system>
      <names>as:in_US,aor:US_in,US_inch,p:US_inches</names>
      <base>
        <unit>m</unit>
        <relation>100/3937</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>Inch</title>
      <system>Imperial/US</system>
      <names>ar:in,inch,p:inches</names>
      <base>
        <unit>m</unit>
        <relation>0.0254</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>Hand</title>
      <system>Imperial/US</system>
      <names>r:hand,p:hands</names>
      <base>
        <unit>in</unit>
        <relation>4</relation>
        <exponent>1</exponent>
        <mix>2</mix>
      </base>
    </unit>
    <unit type="alias">
      <title>Foot</title>
      <system>Imperial/US</system>
      <names>ar:ft,foot,p:feet</names>
      <base>
        <unit>hand</unit>
        <relation>3</relation>
        <exponent>1</exponent>
        <mix>1</mix>
      </base>
    </unit>
    <unit type="alias">
      <title>U.S. Survey Foot</title>
      <system>US Survey</system>
      <names>as:ft_US,aor:US_ft,US_foot,p:US_feet</names>
      <base>
        <unit>US_in</unit>
        <relation>12</relation>
        <exponent>1</exponent>
        <mix>1</mix>
      </base>
    </unit>
    <unit type="alias">
      <title>Link</title>
      <system>Imperial/US</system>
      <names>ar:li,link,p:links</names>
      <base>
        <unit>in</unit>
        <relation>7.92</relation>
        <exponent>1</exponent>
        <mix>3</mix>
      </base>
    </unit>
    <unit type="alias">
      <title>Yard</title>
      <system>Imperial/US</system>
      <names>ar:yd,yard,p:yards</names>
      <base>
        <unit>ft</unit>
        <relation>3</relation>
        <exponent>1</exponent>
        <mix min="12">1</mix>
      </base>
    </unit>
    <unit type="alias">
      <title>Rod (pole/perch)</title>
      <system>Imperial/US</system>
      <names>ar:rd,rod,p:rods</names>
      <base>
        <unit>ft</unit>
        <relation>16.5</relation>
        <exponent>1</exponent>
        <mix>2</mix>
      </base>
    </unit>
    <unit type="alias">
      <title>U.S. Survey Rod</title>
      <system>US Survey</system>
      <names>as:rd_US,aor:US_rd,US_rod,p:US_rods</names>
      <base>
        <unit>US_ft</unit>
        <relation>16.5</relation>
        <exponent>1</exponent>
        <mix>2</mix>
      </base>
    </unit>
    <unit type="alias">
      <title>Fathom</title>
      <system>Imperial/US</system>
      <names>r:fathom,p:fathoms</names>
      <base>
        <unit>yd</unit>
        <relation>2</relation>
        <exponent>1</exponent>
        <mix>2</mix>
      </base>
    </unit>
    <unit type="alias">
      <title>Chain</title>
      <system>Imperial/US</system>
      <names>ar:ch,chain,p:chains</names>
      <base>
        <unit>li</unit>
        <relation>100</relation>
        <exponent>1</exponent>
        <mix>2</mix>
      </base>
    </unit>
    <unit type="alias">
      <title>Furlong</title>
      <system>Imperial/US</system>
      <names>ar:fur,furlong,p:furlongs</names>
      <base>
        <unit>ch</unit>
        <relation>10</relation>
        <exponent>1</exponent>
        <mix>2</mix>
      </base>
    </unit>
    <unit type="alias">
      <title>Mile</title>
      <system>Imperial/US</system>
      <names>ar:mi,mile,p:miles</names>
      <base>
        <unit>yd</unit>
        <relation>1760</relation>
        <exponent>1</exponent>
        <mix>1</mix>
      </base>
    </unit>
    <unit type="alias">
      <title>U.S. Survey Mile</title>
      <system>US Survey</system>
      <names>as:mi_US,aor:US_mi,US_mile,p:US_miles</names>
      <base>
        <unit>US_ft</unit>
        <relation>5280</relation>
        <exponent>1</exponent>
        <mix>1</mix>
      </base>
    </unit>
    <unit type="alias">
      <title>Thou/mil (1/1000 in)</title>
      <system>Imperial/US</system>
      <names>r:thou,mil,po:mils</names>
      <base>
        <unit>in</unit>
        <relation>0.001</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>Astronomical Unit</title>
      <names>a-cr:au,astronomical_unit,p:astronomical_units</names>
      <base>
        <unit>m</unit>
        <relation>149597870700</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>Light Year</title>
      <names>ar:ly,lightyear,p:lightyears</names>
      <base>
        <unit>m</unit>
        <relation>9460730472580800</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>Light Second</title>
      <names>r:light_second,p:light_seconds</names>
      <base>
        <unit>ly</unit>
        <relation>1/31557600</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>Light Minute</title>
      <names>r:light_minute,p:light_minutes</names>
      <base>
        <unit>light_second</unit>
        <relation>60</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>Light Hour</title>
      <names>r:light_hour,p:light_hours</names>
      <base>
        <unit>light_minute</unit>
        <relation>60</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>Parsec</title>
      <names>ar:pc,parsec,p:parsecs</names>
      <use_with_prefixes>true</use_with_prefixes>
      <base>
        <unit>AU</unit>
        <relation>648000/pi</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>Solar Radius (nominal)</title>
      <names>r:solar_radius,au:R_☉</names>
      <base>
        <unit>m</unit>
        <relation>695700000</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>Pied du roi (French Royal Foot)</title>
      <names>r:pied_du_roi,p:pieds_du_roi</names>
      <base>
        <unit>m</unit>
        <relation>9000/27706</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>Pouce (French Royal Inch)</title>
      <names>r:pouce,p:pouces</names>
      <base>
        <unit>pied_du_roi</unit>
        <relation>1/12</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>Ligne</title>
      <names>r:ligne,p:lignes</names>
      <base>
        <unit>pouce</unit>
        <relation>1/12</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>Toise</title>
      <names>r:toise,p:toises</names>
      <base>
        <unit>pied_du_roi</unit>
        <relation>6</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>Planck Length</title>
      <names translatable="no">r:planck_length,as:l_P</names>
      <system>Planck</system>
      <base>
        <unit>m</unit>
        <relation>sqrt(planck2pi*newtonian_constant/c^3)</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>Bohr (Atomic Unit of Length)</title>
      <names translatable="no">rs:bohr_unit,as:a_0unit</names>
      <system>Atomic</system>
      <base>
        <unit>m</unit>
        <relation>bohr_radius</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="composite">
      <title>Electronvolt Distance</title>
      <names translatable="no">planck_c_p_eV</names>
      <part>
        <unit>planck_unit</unit>
        <prefix>0</prefix>
        <exponent>1</exponent>
      </part>
      <part>
        <unit>c_unit</unit>
        <prefix>0</prefix>
        <exponent>1</exponent>
      </part>
      <part>
        <unit>eV</unit>
        <prefix>0</prefix>
        <exponent>-1</exponent>
      </part>
    </unit>
    <unit type="composite">
      <title translatable="no">Planck per Electron Mass Light Speed</title>
      <names translatable="no">planck_p_electron_c</names>
      <system>Natural</system>
      <hidden>true</hidden>
      <part>
        <unit>planck_unit</unit>
        <prefix>0</prefix>
        <exponent>1</exponent>
      </part>
      <part>
        <unit>electron_unit</unit>
        <prefix>0</prefix>
        <exponent>-1</exponent>
      </part>
      <part>
        <unit>c_unit</unit>
        <prefix>0</prefix>
        <exponent>-1</exponent>
      </part>
    </unit>
    <unit type="alias">
      <title>Natural Unit of Length</title>
      <names translatable="no">ars:l_N,aus:ƛ_unit</names>
      <system>Natural</system>
      <base>
        <unit>planck_p_electron_c</unit>
        <relation>1</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>Rack Unit</title>
      <system>Imperial/US</system>
      <names>a:U,r:rack_unit,p:rack_units,a:RU</names>
      <base>
        <unit>in</unit>
        <relation>1.75</relation>
        <exponent>1</exponent>
      </base>
    </unit>
  </category>
  <category>
    <!-- Unit category -->
    <title>!units!Angle</title>
    <category>
      <title>Plane Angle</title>
      <unit type="base">
        <system>SI</system>
        <title>Radian</title>
        <names>ar:rad,radian,p:radians</names>
        <use_with_prefixes>false</use_with_prefixes>
      </unit>
      <unit type="alias">
        <!--angle unit-->
        <title>Degree</title>
        <names>ar:deg,au:°,degree,p:degrees</names>
        <use_with_prefixes>false</use_with_prefixes>
        <base>
          <unit>rad</unit>
          <relation>pi/180</relation>
          <exponent>1</exponent>
        </base>
      </unit>
      <unit type="alias">
        <title>Gradian (Gon)</title>
        <names>ar:gra,gradian,p:gradians,gon,p:gons</names>
        <use_with_prefixes>false</use_with_prefixes>
        <base>
          <unit>rad</unit>
          <relation>pi/200</relation>
          <exponent>1</exponent>
        </base>
      </unit>
      <unit type="alias">
        <title>Arcminute</title>
        <names>ar:arcmin,arcminute,p:arcminutes</names>
        <base>
          <unit>deg</unit>
          <relation>1/60</relation>
          <exponent>1</exponent>
        </base>
      </unit>
      <unit type="alias">
        <title>Arcsecond</title>
        <names>ar:arcsec,arcsecond,p:arcseconds</names>
        <base>
          <unit>arcmin</unit>
          <relation>1/60</relation>
          <exponent>1</exponent>
        </base>
      </unit>
      <unit type="alias">
        <title>Turn</title>
        <names>a:tr,r:turn,p:turns,a:pla,a:rev,revolution,p:revolutions,a:cyc,cycle,p:cycles</names>
        <base>
          <unit>deg</unit>
          <relation>360</relation>
          <exponent>1</exponent>
        </base>
      </unit>
    </category>
    <category>
      <title>Solid Angle</title>
      <unit type="composite">
        <title translatable="no">Square Degree</title>
        <names translatable="no">r:sqdeg</names>
        <part>
          <unit>deg</unit>
          <prefix>0</prefix>
          <exponent>2</exponent>
        </part>
      </unit>
      <unit type="alias">
        <system>SI</system>
        <title>Steradian</title>
        <names>ar:sr,steradian,p:steradians</names>
        <base>
          <unit>rad</unit>
          <relation>1</relation>
          <exponent>2</exponent>
        </base>
      </unit>
    </category>
    <category>
      <title>Angular Acceleration</title>
      <unit type="composite">
        <system>SI</system>
        <title>Radians per Second Squared</title>
        <names translatable="no">r:rad_p_sqs</names>
        <part>
          <unit>rad</unit>
          <prefix>0</prefix>
          <exponent>1</exponent>
        </part>
        <part>
          <unit>s</unit>
          <prefix>0</prefix>
          <exponent>-2</exponent>
        </part>
      </unit>
    </category>
    <category>
      <title>Angular Velocity</title>
      <unit type="composite">
        <system>SI</system>
        <title>Radians per Second</title>
        <names translatable="no">r:rad_p_s</names>
        <part>
          <unit>rad</unit>
          <prefix>0</prefix>
          <exponent>1</exponent>
        </part>
        <part>
          <unit>s</unit>
          <prefix>0</prefix>
          <exponent>-1</exponent>
        </part>
      </unit>
      <unit type="composite">
        <hidden>true</hidden>
        <title translatable="no">Revolutions per Minute</title>
        <names translatable="no">r:turn_p_min</names>
        <part>
          <unit>turn</unit>
          <prefix>0</prefix>
          <exponent>1</exponent>
        </part>
        <part>
          <unit>min</unit>
          <prefix>0</prefix>
          <exponent>-1</exponent>
        </part>
      </unit>
      <unit type="alias">
        <title>Revolutions per Minute (RPM)</title>
        <names>ar:rpm</names>
        <base>
          <unit>turn_p_min</unit>
          <relation>1</relation>
          <exponent>1</exponent>
        </base>
      </unit>
    </category>
  </category>
  <category>
    <!-- Unit category -->
    <title>!units!Mass</title>
    <unit type="base">
      <system>SI</system>
      <title>Gram</title>
      <names>ar:g,gram,p:grams</names>
      <use_with_prefixes max="3" default="3">true</use_with_prefixes>
    </unit>
    <unit type="composite">
      <system>SI</system>
      <title>Kilogram</title>
      <names translatable="no">r:kg_c</names>
      <part>
        <unit>g</unit>
        <prefix>3</prefix>
        <exponent>1</exponent>
      </part>
    </unit>
    <unit type="composite">
      <title>Hectogram</title>
      <names translatable="no">r:hg_c</names>
      <part>
        <unit>g</unit>
        <prefix>2</prefix>
        <exponent>1</exponent>
      </part>
    </unit>
    <unit type="alias">
      <title>Metric Ton (Tonne)</title>
      <names>ar:t,tonne,p:tonnes,ton,p:tons</names>
      <use_with_prefixes min="0">true</use_with_prefixes>
      <base>
        <unit>g</unit>
        <relation>1000000</relation>
