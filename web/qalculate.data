    <category>
      <title>Atomic and Nuclear Constants</title>
      <variable>
        <title>Bohr Radius</title>
        <names translatable="no">r:bohr_radius,as:a_0</names>
        <value>planck2pi/(fine_structure*electron_mass*c)</value>
      </variable>
      <variable>
        <title>Classical Electron Radius</title>
        <names translatable="no">r:classical_electron_radius,as:r_e</names>
        <value>elementary_charge^2/(4*pi*electric_constant*electron_mass*c^2)</value>
      </variable>
      <variable>
        <title>Fermi Coupling Constant</title>
        <names translatable="no">r:fermi_coupling</names>
        <value unit="GeV^(-2)" uncertainty="6E-12">1.1663787E-5</value>
      </variable>
      <variable>
        <title>Fine-Structure Constant</title>
        <names translatable="no">r:fine_structure,au:α,ao:alpha</names>
        <value uncertainty="1.1322E-12">7.29735256434E-3</value>
      </variable>
      <variable>
        <title>Hartree Energy (constant)</title>
        <names translatable="no">rs:hartree_constant,as:Ha_constant</names>
        <value>2*rydberg*planck*c</value>
      </variable>
      <variable>
        <title>Quantum of Circulation</title>
        <names translatable="no">r:quantum_circulation</names>
        <value>planck/(2*electron_mass)</value>
      </variable>
      <variable>
        <title>Quantum of Circulation times 2</title>
        <names translatable="no">r:quantum_circulation_2</names>
        <value>quantum_circulation*2</value>
      </variable>
      <variable>
        <title>Rydberg Constant</title>
        <names translatable="no">r:rydberg,asu:R_∞</names>
        <value uncertainty="0.000012" unit="m^(-1)">10973731.56815693</value>
      </variable>
      <variable>
        <title>Thomson cross section</title>
        <names translatable="no">r:thomson_cross_section,asu:σ_t,aos:sigma_t</names>
        <value>(8*pi/3)*classical_electron_radius^2</value>
      </variable>
      <variable>
        <title>Weak Mixing Angle (sin²θw)</title>
        <names translatable="no">weak_mixing_angle,asu:sin2θ_W,r:weinberg,aos:sin2_theta_W</names>
        <value>1-w_z_ratio^2</value>
      </variable>
      <variable>
        <title>W to Z Mass Ratio</title>
        <names translatable="no">r:w_z_ratio</names>
        <value uncertainty="0.00013">0.88145</value>
      </variable>
    </category>
    <category>
      <title>Physico-Chemical Constants</title>
      <variable>
        <title>Lattice Spacing of Ideal Silicon (220)</title>
        <names translatable="no">rs:lattice_spacing_Si220,as:d_220</names>
        <value>lattice_parameter_Si/sqrt(8)</value>
      </variable>
      <variable>
        <title>Atomic Mass Constant</title>
        <names translatable="no">r:atomic_mass_constant,as:m_u</names>
        <value units="auto">(2*rydberg*planck)/(c*fine_structure^2*nounit(electron_u))</value>
      </variable>
      <variable>
        <title>Avogadro Constant</title>
        <names translatable="no">r:avogadro,as:N_A</names>
        <value unit="mol^(-1)">6.02214076E23</value>
      </variable>
      <variable>
        <title>Boltzmann Constant</title>
        <names translatable="no">r:boltzmann,as:k_B</names>
        <value unit="J*K^(-1)">1.380649E-23</value>
      </variable>
      <variable>
        <title>Molar Mass Constant</title>
        <names translatable="no">r:molar_mass,as:M_u</names>
        <value>(2*planck*rydberg*avogadro)/(c*fine_structure^2*nounit(electron_u))</value>
      </variable>
      <variable>
        <title>Electronvolt (constant)</title>
        <names translatable="no">rs:electronvolt_constant,as:eV_constant</names>
        <value unit="auto">elementary_charge/C*J</value>
      </variable>
      <variable>
        <title>Faraday Constant</title>
        <names translatable="no">r:faraday,au:ℱ</names>
        <value>avogadro*elementary_charge</value>
      </variable>
      <variable>
        <title>First Radiation Constant</title>
        <names translatable="no">r:first_radiation,as:c_1</names>
        <value>2*pi*planck*c^2</value>
      </variable>
      <variable>
        <title>First Radiation Constant for Spectral Radiance</title>
        <names translatable="no">rs:first_radiation_sr,as:c_1L</names>
        <value>first_radiation/pi</value>
      </variable>
      <variable>
        <title>Gas Constant</title>
        <names translatable="no">r:gas_constant,ideal_gas</names>
        <value>boltzmann*avogadro</value>
      </variable>
      <variable>
        <title>Lattice Parameter of Silicon</title>
        <names translatable="no">rs:lattice_parameter_Si</names>
        <value unit="m" uncertainty="8.9E-18">543.1020511E-12</value>
      </variable>
      <variable>
        <title>Loschmidt Constant (273.15 K, 100 kPa)</title>
        <names translatable="no">rs:loschmidt_100,aos:n_0100</names>
        <value unit="auto">(100000*Pa)/(boltzmann*273.15*K)</value>
      </variable>
      <variable>
        <title>Loschmidt Constant (273.15 K, 101.325 kPa)</title>
        <names translatable="no">rs:loschmidt_atm,ros:loschmidt,aos:n_0</names>
        <value unit="auto">(101325*Pa)/(boltzmann*273.15*K)</value>
      </variable>
      <variable>
        <title>Molar Planck Constant</title>
        <names translatable="no">r:molar_planck</names>
        <value>avogadro*planck</value>
      </variable>
      <variable>
        <title>Molar Volume of Ideal Gas (273.15 K, 100 kPa)</title>
        <names translatable="no">s:ideal_gas_molar_100,r:ideal_gas_molar,as:V_m</names>
        <value unit="auto">(gas_constant*273.15*K)/(100000*Pa)</value>
      </variable>
      <variable>
        <title>Molar Volume of Ideal Gas (273.15 K, 101.325 kPa)</title>
        <names translatable="no">rs:ideal_gas_molar_atm,ros:ideal_gas_molar_101,aos:V_m101</names>
        <value unit="auto">(gas_constant*273.15*K)/(101325*Pa)</value>
      </variable>
      <variable>
        <title>Sackur-Tetrode constant (1 K, 100 kPa)</title>
        <names translatable="no">s:sackur_tetrode_100,r:sackur_tetrode</names>
        <value uncertainty="4.7E-10">-1.15170753496</value>
      </variable>
      <variable>
        <title>Sackur-Tetrode constant (1 K, 101.325 kPa)</title>
        <names translatable="no">rs:sackur_tetrode_atm,ros:sackur_tetrode_101</names>
        <value uncertainty="4.7E-10">-1.16487052149</value>
      </variable>
      <variable>
        <title>Second Radiation Constant</title>
        <names translatable="no">r:second_radiation,as:c_2</names>
        <value>planck*c/boltzmann</value>
      </variable>
      <variable>
        <title>Stefan-Boltzmann Constant</title>
        <names translatable="no">r:stefan,au:σ,ao:sigma</names>
        <value>(2pi^5*boltzmann^4)/(15*planck^3*c^2)</value>
      </variable>
      <variable>
        <title>Wien frequency displacement law constant</title>
        <names translatable="no">r:wien_frequency</names>
        <value>(k_B/planck)×(lambertw(−3/e^3)+3)</value>
      </variable>
      <variable>
        <title>Wien wavelength displacement law constant</title>
        <names translatable="no">r:wien_displacement,ais:b_energy</names>
        <value>(planck×c/k_B)/(lambertw(−5/e^5)+5)</value>
      </variable>
    </category>
    <category>
      <title>Conversion factors for energy equivalents</title>
      <variable>
        <title>Hertz - Inverse Meter Relationship</title>
        <names translatable="no">r:Hz_to_m</names>
        <value>1/c</value>
      </variable>
      <variable>
        <title>Hertz - Joule Relationship</title>
        <names translatable="no">r:Hz_to_J</names>
        <value>planck</value>
      </variable>
      <variable>
        <title>Hertz - Kelvin Relationship</title>
        <names translatable="no">r:Hz_to_K</names>
        <value>planck/boltzmann</value>
      </variable>
      <variable>
        <title>Hertz - Kilogram Relationship</title>
        <names translatable="no">r:Hz_to_kg</names>
        <value>planck/c^2</value>
      </variable>
      <variable>
        <title>Inverse Meter - Hertz Relationship</title>
        <names translatable="no">r:m_to_Hz</names>
        <value>c</value>
      </variable>
      <variable>
        <title>Inverse Meter - Joule Relationship</title>
        <names translatable="no">r:m_to_J</names>
        <value>planck*c</value>
      </variable>
      <variable>
        <title>Inverse Meter - Kelvin Relationship</title>
        <names translatable="no">r:m_to_K</names>
        <value>planck*c/boltzmann</value>
      </variable>
      <variable>
        <title>Inverse Meter - Kilogram Relationship</title>
        <names translatable="no">r:m_to_kg</names>
        <value>planck/c</value>
      </variable>
      <variable>
        <title>Joule - Hertz Relationship</title>
        <names translatable="no">r:J_to_Hz</names>
        <value>1/planck</value>
      </variable>
      <variable>
        <title>Joule - Inverse Meter Relationship</title>
        <names translatable="no">r:J_to_m</names>
        <value>1/(planck*c)</value>
      </variable>
      <variable>
        <title>Joule - Kelvin Relationship</title>
        <names translatable="no">r:J_to_K</names>
        <value>1/boltzmann</value>
      </variable>
      <variable>
        <title>Joule - Kilogram Relationship</title>
        <names translatable="no">r:J_to_kg</names>
        <value>1/c^2</value>
      </variable>
      <variable>
        <title>Kelvin - Hertz Relationship</title>
        <names translatable="no">r:K_to_Hz</names>
        <value>boltzmann/planck</value>
      </variable>
      <variable>
        <title>Kelvin - Inverse Meter Relationship</title>
        <names translatable="no">r:K_to_m</names>
        <value>boltzmann/(planck*c)</value>
      </variable>
      <variable>
        <title>Kelvin - Joule Relationship</title>
        <names translatable="no">r:K_to_J</names>
        <value>boltzmann</value>
      </variable>
      <variable>
        <title>Kelvin - Kilogram Relationship</title>
        <names translatable="no">r:K_to_kg</names>
        <value>boltzmann/c^2</value>
      </variable>
      <variable>
        <title>Kilogram - Hertz Relationship</title>
        <names translatable="no">r:kg_to_Hz</names>
        <value>c^2/planck</value>
      </variable>
      <variable>
        <title>Kilogram - Inverse Meter Relationship</title>
        <names translatable="no">r:kg_to_m</names>
        <value>c/planck</value>
      </variable>
      <variable>
        <title>Kilogram - Joule Relationship</title>
        <names translatable="no">r:kg_to_J</names>
        <value>c^2</value>
      </variable>
      <variable>
        <title>Kilogram - Kelvin Relationship</title>
        <names translatable="no">r:kg_to_K</names>
        <value>c^2/boltzmann</value>
      </variable>
    </category>
  </category>
  <category>
    <title>Basic Constants</title>
    <variable>
      <title>Golden Ratio</title>
      <names translatable="no">r:golden,au:φ,aos:phi</names>
      <value>(1+sqrt(5))/2</value>
    </variable>
    <variable>
      <title>Omega Constant</title>
      <names translatable="no">r:omega</names>
      <value>lambertw(1)</value>
    </variable>
    <variable>
      <title>Pythagoras' Constant (sqrt 2)</title>
      <names translatable="no">r:pythagoras</names>
      <value>sqrt(2)</value>
    </variable>
    <variable>
      <title>Apery's Constant</title>
      <names translatable="no">r:apery</names>
      <value>zeta(3)</value>
    </variable>
    <variable>
      <title>Tau (2pi)</title>
      <names translatable="no">au:τ,r:tau</names>
      <value>2*pi</value>
    </variable>
    <variable>
      <title>Plastic Number</title>
      <names translatable="no">r:plastic,au:ρ,aos:rho</names>
      <value>cbrt((9+sqrt(69))/18)+cbrt((9-sqrt(69))/18)</value>
    </variable>
    <builtin_variable name="e">
      <title>Base of Natural Logarithms (e)</title>
      <names translatable="no">r:e</names>
    </builtin_variable>
    <builtin_variable name="pi">
      <title>Archimedes' Constant (pi)</title>
      <names translatable="no">au:π,r:pi</names>
    </builtin_variable>
    <builtin_variable name="euler">
      <title>Euler's Constant</title>
      <names translatable="no">au:γ,r:euler</names>
    </builtin_variable>
    <builtin_variable name="catalan">
      <title>Catalan's Constant</title>
      <names translatable="no">r:catalan</names>
    </builtin_variable>
  </category>
  <category>
    <title>Special Numbers</title>
    <builtin_variable name="i">
      <title>Imaginary i (sqrt -1)</title>
      <names translatable="no">r:i</names>
    </builtin_variable>
    <builtin_variable name="plus_infinity">
      <title>Positive Infinity</title>
      <names>a:∞,r:plus_infinity,r:infinity</names>
    </builtin_variable>
    <builtin_variable name="minus_infinity">
      <title>Negative Infinity</title>
      <names>r:minus_infinity</names>
    </builtin_variable>
    <builtin_variable name="undefined">
      <title>Undefined</title>
      <names>r:undefined</names>
    </builtin_variable>
    <variable>
      <title>False</title>
      <names>r:false,r:no</names>
      <value>0</value>
    </variable>
    <variable>
      <title>True</title>
      <names>r:true,r:yes</names>
      <value>1</value>
    </variable>
  </category>
  <category>
    <title>Matrices &amp; Vectors</title>
    <variable>
      <title>Pauli Matrix 0</title>
      <names>rs:pauli_0,aus:σ_0</names>
      <value>[1 0; 0 1]</value>
    </variable>
    <variable>
      <title>Pauli Matrix 1</title>
      <names>rs:pauli_1,aus:σ_1</names>
      <value>[0 1; 1 0]</value>
    </variable>
    <variable>
      <title>Pauli Matrix 2</title>
      <names>rs:pauli_2,aus:σ_2</names>
      <value>[0 -i; i 0]</value>
    </variable>
    <variable>
      <title>Pauli Matrix 3</title>
      <names>rs:pauli_3,aus:σ_3</names>
      <value>[1 0; 0 -1]</value>
    </variable>
  </category>
  <category>
    <title>Utilities</title>
    <builtin_variable name="precision">
      <title>Precision</title>
      <names>r:precision</names>
    </builtin_variable>
    <builtin_variable name="uptime">
      <title>System Uptime</title>
      <names>r:uptime</names>
    </builtin_variable>
  </category>
  <category>
    <title>Unknowns</title>
    <unknown>
      <names translatable="no">r:x</names>
    </unknown>
    <unknown>
      <names translatable="no">r:y</names>
    </unknown>
