  </category>
  <category>
    <title>Date &amp; Time</title>
    <builtin_variable name="today">
      <title>Today</title>
      <names>r:today</names>
    </builtin_variable>
    <builtin_variable name="tomorrow">
      <title>Tomorrow</title>
      <names>r:tomorrow</names>
    </builtin_variable>
    <builtin_variable name="yesterday">
      <title>Yesterday</title>
      <names>r:yesterday</names>
