    <category>
      <title>Particle Mass in kg</title>
      <variable>
        <title>Deuteron Mass</title>
        <names translatable="no">rs:deuteron_mass</names>
        <value>nounit(deuteron_u)*atomic_mass_constant</value>
      </variable>
      <variable>
        <title>Electron Mass</title>
        <names translatable="no">rs:electron_mass,as:m_e</names>
        <value>(2*rydberg*planck)/(c*fine_structure^2)</value>
      </variable>
      <variable>
        <title>Helion Mass</title>
        <names translatable="no">rs:helion_mass,as:m_h</names>
        <value>nounit(helion_u)*atomic_mass_constant</value>
      </variable>
      <variable>
        <title>Neutron Mass</title>
        <names translatable="no">rs:neutron_mass,as:m_n</names>
        <value>nounit(neutron_u)*atomic_mass_constant</value>
