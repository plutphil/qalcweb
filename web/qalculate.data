    </unit>
    <unit type="alias">
      <system>SI</system>
      <title>Degree Celsius</title>
      <names>ar:oC,au:°C,au:℃,r:celsius,p:celsius,centigrade,p:centigrades</names>
      <use_with_prefixes>false</use_with_prefixes>
      <base>
        <unit>K</unit>
        <relation>\x + 273.15</relation>
        <inverse_relation>\x - 273.15</inverse_relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>Degree Rankine</title>
      <system>Imperial/US</system>
      <names>ar:oR,a:oRa,au:°R,au:°Ra,r:rankine</names>
      <base>
        <unit>K</unit>
        <relation>5/9</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>Degree Fahrenheit</title>
      <system>Imperial/US</system>
      <names>ar:oF,au:°F,au:℉,r:fahrenheit</names>
      <base>
        <unit>K</unit>
        <relation>(\x+459.67)*5/9</relation>
        <inverse_relation>(\x*9/5)-459.67</inverse_relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>Planck Temperature</title>
      <names translatable="no">r:planck_temperature,as:T_P</names>
      <system>Planck</system>
      <base>
        <unit>K</unit>
        <relation>sqrt((planck2pi*c^5)/newtonian_constant)/boltzmann</relation>
        <exponent>1</exponent>
      </base>
    </unit>
