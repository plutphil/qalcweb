  <category>
    <title>Physical Constants</title>
    <category>
      <title>Universal Constants</title>
      <variable>
        <title>Characteristic Impedance of Vacuum</title>
        <names translatable="no">r:characteristic_impedance,as:Z_0</names>
        <value>(2*planck*fine_structure)/(elementary_charge^2)</value>
      </variable>
      <variable>
        <title>Electric Constant (Permittivity of Free Space)</title>
        <names translatable="no">r:electric_constant,asu:ε_0,vacuum_permittivity,aos:epsilon_0</names>
        <value>elementary_charge^2/(2*planck*fine_structure*c)</value>
      </variable>
      <variable>
        <title>Magnetic Constant (Permeability of Free Space)</title>
        <names translatable="no">r:magnetic_constant,asu:μ_0,asou:µ_0,vacuum_permeability,aos:mu_0</names>
        <value>(2*planck*fine_structure)/(c*elementary_charge^2)</value>
      </variable>
      <variable>
        <title>Planck Constant</title>
        <names translatable="no">r:planck,au:&#x210e;</names>
        <value unit="J*s">6.62607015E-34</value>
      </variable>
      <variable>
        <title>Reduced Planck Constant (Dirac constant)</title>
        <names translatable="no">r:planck2pi,dirac,au:&#x210f;,o:hbar</names>
        <value>planck/(2*pi)</value>
      </variable>
      <variable>
        <title>Newtonian Constant of Gravitation</title>
        <names translatable="no">r:newtonian_constant,a:G</names>
        <value uncertainty="1.5E-15" unit="m^3*kg^(-1)*s^(-2)">6.67430E-11</value>
      </variable>
      <variable>
        <title>Speed of Light in Vacuum</title>
        <names translatable="no">ar:c,speed_of_light</names>
        <value unit="m*s^(-1)">299792458</value>
      </variable>
      <variable>
        <title>Standard Acceleration due to Gravity</title>
        <names translatable="no">r:standard_gravity,asu:g_0,asu:ɡ_0,asu:ɡ_n</names>
        <value unit="m s^(-2)">9.80665</value>
      </variable>
    </category>
    <category>
      <title>Electromagnetic Constants</title>
      <variable>
        <title>Bohr Magneton</title>
        <names translatable="no">r:bohr_magneton,asu:μ_B,asou:µ_B,aos:mu_B</names>
        <value>(elementary_charge*planck)/(4*electron_mass*pi)</value>
      </variable>
      <variable>
        <title>Conductance Quantum</title>
        <names translatable="no">r:conductance_quantum,as:G_0</names>
        <value>2*elementary_charge^2/planck</value>
      </variable>
      <variable>
        <title>Coulomb's Constant (Electric Force Constant)</title>
        <names translatable="no">r:coulombs_constant,as:k_e</names>
        <value>(magnetic_constant*c^2)/(4pi)</value>
      </variable>
      <variable>
        <title>Elementary Charge</title>
        <names translatable="no">r:elementary_charge,as:q_e,as:e_charge</names>
        <value unit="C">1.602176634E-19</value>
      </variable>
      <variable>
        <title>Inverse of Conductance Quantum</title>
        <names translatable="no">r:inverse_conductance_quantum</names>
        <value>planck/(2*elementary_charge^2)</value>
      </variable>
      <variable>
        <title>Josephson Constant</title>
        <names translatable="no">r:josephson,as:K_J</names>
        <value>2*elementary_charge/planck</value>
      </variable>
      <variable>
        <title>Josephson Constant (conventional value)</title>
        <names translatable="no">rs:josephson_conventional,as:K_J90</names>
        <value unit="Hz*V^(-1)">4.835979E14</value>
      </variable>
      <variable>
        <title>Magnetic Flux Quantum</title>
        <names translatable="no">r:magnetic_flux_quantum,asu:Φ_0,aos:phi_0</names>
        <value>planck/(2*elementary_charge)</value>
      </variable>
      <variable>
        <title>Nuclear Magneton</title>
        <names translatable="no">r:nuclear_magneton,asu:μ_N,asou:µ_N,aos:mu_N</names>
        <value>elementary_charge*planck2pi/(2*proton_mass)</value>
      </variable>
      <variable>
        <title>von Klitzing Constant</title>
        <names translatable="no">r:klitzing,as:R_K</names>
        <value>planck/elementary_charge^2</value>
      </variable>
      <variable>
        <title>von Klitzing Constant (conventional value)</title>
        <names translatable="no">rs:klitzing_conventional,as:R_K90</names>
        <value unit="ohm">25812.807</value>
      </variable>
    </category>
