      </variable>
      <variable>
        <title>Alpha Particle Mass</title>
        <names translatable="no">rs:alpha_particle_mass,asu:m_α,aos:m_alpha</names>
        <value>nounit(alpha_particle_u)*atomic_mass_constant</value>
      </variable>
    </category>
    <category>
      <title>Compton Wavelength</title>
      <variable>
        <title>Compton Wavelength (electron)</title>
        <names translatable="no">r:compton_wavelength,asu:λ_C,aos:lambda_C</names>
        <value>planck/(electron_mass*c)</value>
      </variable>
      <variable>
        <title>Reduced Compton Wavelength (electron)</title>
        <names translatable="no">r:compton_wavelength_2pi,asu:&#x019b;_C</names>
        <value>planck2pi/(electron_mass*c)</value>
      </variable>
      <variable>
        <title>Muon Compton Wavelength</title>
        <names translatable="no">r:muon_compton_wavelength,asu:λ_Cμ</names>
        <value>planck/(muon_mass*c)</value>
      </variable>
      <variable>
        <title>Reduced Muon Compton Wavelength</title>
        <names translatable="no">r:muon_compton_wavelength_2pi,asu:&#x019b;_Cμ</names>
        <value>planck2pi/(muon_mass*c)</value>
      </variable>
      <variable>
        <title>Neutron Compton Wavelength</title>
        <names translatable="no">r:neutron_compton_wavelength,asu:λ_Cn</names>
        <value>planck/(neutron_mass*c)</value>
      </variable>
      <variable>
        <title>Reduced Neutron Compton Wavelength</title>
        <names translatable="no">r:neutron_compton_wavelength_2pi,asu:&#x019b;_Cn</names>
        <value>planck2pi/(neutron_mass*c)</value>
      </variable>
      <variable>
        <title>Proton Compton Wavelength</title>
        <names translatable="no">r:proton_compton_wavelength,asu:λ_Cp</names>
        <value>planck/(proton_mass*c)</value>
      </variable>
      <variable>
        <title>Reduced Proton Compton Wavelength</title>
        <names translatable="no">r:proton_compton_wavelength_2pi,asu:&#x019b;_Cp</names>
        <value>planck2pi/(proton_mass*c)</value>
      </variable>
      <variable>
        <title>Tau Compton Wavelength</title>
        <names translatable="no">r:tau_compton_wavelength,asu:λ_Cτ</names>
        <value>planck/(tau_mass*c)</value>
      </variable>
      <variable>
        <title>Reduced Tau Compton Wavelength</title>
        <names translatable="no">r:tau_compton_wavelength_2pi,asu:&#x019b;_Cτ</names>
        <value>planck2pi/(tau_mass*c)</value>
      </variable>
