        <title>Rad</title>
        <names>rs:rad_radioactivity</names>
        <base>
          <unit>Gy</unit>
          <relation>1/100</relation>
          <exponent>1</exponent>
        </base>
      </unit>
      <unit type="composite">
        <title>Erg per Gram</title>
        <names translatable="no">r:erg_p_g</names>
        <part>
          <unit>erg</unit>
          <prefix>0</prefix>
          <exponent>1</exponent>
        </part>
        <part>
          <unit>g</unit>
          <prefix>0</prefix>
          <exponent>-1</exponent>
        </part>
      </unit>
    </category>
    <category>
      <title>Dose Equivalent</title>
      <unit type="alias">
        <system>SI</system>
        <title>Sievert</title>
        <names>ar:Sv,sievert,p:sieverts</names>
        <base>
          <unit>J_p_kg</unit>
          <relation>1</relation>
          <exponent>1</exponent>
        </base>
      </unit>
      <unit type="alias">
        <system>CGS</system>
        <title>Roentgen Equivalent Man (Rem)</title>
        <names>ros:rem_radioactivity,a:rem</names>
        <base>
          <unit>Sv</unit>
          <relation>1/100</relation>
          <exponent>1</exponent>
        </base>
      </unit>
      <unit type="composite">
        <system>CGS</system>
        <title>Millirem</title>
        <names translatable="no">r:mrem_c</names>
        <part>
          <unit>rem_radioactivity</unit>
          <prefix>-3</prefix>
          <exponent>1</exponent>
        </part>
      </unit>
    </category>
    <category>
      <title>Exposure</title>
      <unit type="composite">
        <system>SI</system>
        <title>Coulomb per Kilogram</title>
        <names translatable="no">r:C_p_kg</names>
        <part>
          <unit>C</unit>
          <prefix>0</prefix>
          <exponent>1</exponent>
        </part>
        <part>
          <unit>g</unit>
          <prefix>3</prefix>
          <exponent>-1</exponent>
        </part>
      </unit>
      <unit type="alias">
        <title>Roentgen</title>
        <names>ar:R,roentgen,r&#x00f6;ntgen,p:roentgens,p:r&#x00f6;ntgens</names>
        <base>
          <unit>C_p_kg</unit>
          <relation>0.000258</relation>
          <exponent>1</exponent>
        </base>
      </unit>
    </category>
    <category>
      <title>Absorbed Dose Rate</title>
      <unit type="composite">
        <system>SI</system>
        <title>Gray per Second</title>
        <names translatable="no">r:Gy_p_s</names>
        <part>
          <unit>Gy</unit>
          <prefix>0</prefix>
          <exponent>1</exponent>
        </part>
        <part>
          <unit>s</unit>
          <prefix>0</prefix>
          <exponent>-1</exponent>
        </part>
      </unit>
      <unit type="composite">
        <system>CGS</system>
        <title>Millirem per Hour</title>
        <names translatable="no">r:mrem_p_h</names>
        <part>
          <unit>rem_radioactivity</unit>
          <prefix>-3</prefix>
          <exponent>1</exponent>
        </part>
        <part>
          <unit>h</unit>
          <prefix>0</prefix>
          <exponent>-1</exponent>
        </part>
      </unit>
    </category>
  </category>
  <category>
    <title>Ratio</title>
    <unit type="base">
      <title>Neper</title>
      <names>ar:Np,neper,p:nepers</names>
    </unit>
    <unit type="alias">
      <title>Bel</title>
      <names>r:bel,p:bels</names>
      <base>
        <unit>Np</unit>
        <relation>0.5*ln(10)</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>Decibel</title>
      <names>ar:dB,decibel,p:decibels</names>
      <base>
        <unit>bel</unit>
        <relation>0.1</relation>
        <exponent>1</exponent>
      </base>
    </unit>
  </category>
  <category>
    <title>Information</title>
    <unit type="base">
      <title>Bit (Binary Digit)</title>
      <names>r:bit,p:bits,shannon,p:shannons,c:Sh,binary_digit,p:binary_digits</names>
      <use_with_prefixes min="0">true</use_with_prefixes>
    </unit>
    <unit type="alias">
      <title>Nat</title>
      <names>r:nat,p:nats</names>
      <base>
        <unit>bit</unit>
        <relation>log2(e)</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>Trit (Ternary Digit)</title>
      <names>r:trit,p:trits,trinary_digit,p:trinary_digits,ternary_digit,p:ternary_digits</names>
      <base>
        <unit>bit</unit>
        <relation>log2(3)</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>Octal Digit</title>
      <names>r:octal_digit,p:octal_digits</names>
      <base>
        <unit>bit</unit>
        <relation>3</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>Hartley (Decimal Digit)</title>
      <names>r:hartley,p:hartleys,a:Hart,dit,p:dits,decimal_digit,p:decimal_digits</names>
      <base>
        <unit>bit</unit>
        <relation>log2(10)</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>Byte (8-bit)</title>
      <names>r:byte,a:B,p:bytes,octet,p:octets,a:o</names>
      <use_with_prefixes min="0">true</use_with_prefixes>
      <base>
        <unit>bit</unit>
        <relation>8</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>Nibble (Hexadecimal Digit)</title>
      <names>r:nibble,p:nibbles,nybble,p:nybbles,semioctet,p:semioctets,hex_digit,p:hex_digits,hexadecimal_digit,p:hexadecimal_digits</names>
      <base>
        <unit>bit</unit>
        <relation>4</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>Tribble</title>
      <names>r:tribble,p:tribbles</names>
      <base>
        <unit>nibble</unit>
        <relation>3</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>Nonet</title>
      <names>r:nonet,p:nonets</names>
      <base>
        <unit>bit</unit>
        <relation>9</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>Declet</title>
      <names>r:declet,p:declets</names>
      <base>
        <unit>bit</unit>
        <relation>10</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>Word (16-bit)</title>
      <names>r:word,p:words</names>
      <base>
        <unit>bit</unit>
        <relation>16</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="composite">
      <title>Kilobyte</title>
      <names translatable="no">r:kbyte_c</names>
      <part>
        <unit>byte</unit>
        <prefix>3</prefix>
        <exponent>1</exponent>
      </part>
    </unit>
    <unit type="composite">
      <title>Megabyte</title>
      <names translatable="no">r:Mbyte_c</names>
      <part>
        <unit>byte</unit>
        <prefix>6</prefix>
        <exponent>1</exponent>
      </part>
    </unit>
    <unit type="composite">
      <title>Gigabyte</title>
      <names translatable="no">r:Gbyte_c</names>
      <part>
        <unit>byte</unit>
        <prefix>9</prefix>
        <exponent>1</exponent>
      </part>
    </unit>
    <unit type="composite">
      <title>Terabyte</title>
      <names translatable="no">r:Tbyte_c</names>
      <part>
        <unit>byte</unit>
        <prefix>12</prefix>
        <exponent>1</exponent>
      </part>
    </unit>
    <unit type="composite">
      <title>Petabyte</title>
      <names translatable="no">r:Pbyte_c</names>
      <part>
        <unit>byte</unit>
        <prefix>15</prefix>
        <exponent>1</exponent>
      </part>
    </unit>
    <unit type="composite">
      <title>Exabyte</title>
      <names translatable="no">r:Ebyte_c</names>
      <part>
        <unit>byte</unit>
        <prefix>18</prefix>
        <exponent>1</exponent>
      </part>
    </unit>
    <unit type="composite">
      <title>Kibibyte</title>
      <names translatable="no">r:Kibyte_c</names>
      <part>
        <unit>byte</unit>
        <prefix type="binary">10</prefix>
        <exponent>1</exponent>
      </part>
    </unit>
    <unit type="composite">
      <title>Mebibyte</title>
      <names translatable="no">r:Mibyte_c</names>
      <part>
        <unit>byte</unit>
        <prefix type="binary">20</prefix>
        <exponent>1</exponent>
      </part>
    </unit>
    <unit type="composite">
      <title>Gibibyte</title>
      <names translatable="no">r:Gibyte_c</names>
      <part>
        <unit>byte</unit>
        <prefix type="binary">30</prefix>
        <exponent>1</exponent>
      </part>
    </unit>
    <unit type="composite">
      <title>Tebibyte</title>
      <names translatable="no">r:Tibyte_c</names>
      <part>
        <unit>byte</unit>
        <prefix type="binary">40</prefix>
        <exponent>1</exponent>
      </part>
    </unit>
    <unit type="composite">
      <title>Kilobit</title>
      <names translatable="no">r:kbit_c</names>
      <part>
        <unit>bit</unit>
        <prefix>3</prefix>
        <exponent>1</exponent>
      </part>
    </unit>
    <unit type="composite">
      <title>Megabit</title>
      <names translatable="no">r:Mbit_c</names>
      <part>
        <unit>bit</unit>
        <prefix>6</prefix>
        <exponent>1</exponent>
      </part>
    </unit>
    <unit type="composite">
      <title>Gigabit</title>
      <names translatable="no">r:Gbit_c</names>
      <part>
        <unit>bit</unit>
        <prefix>9</prefix>
        <exponent>1</exponent>
      </part>
    </unit>
    <unit type="composite">
      <title>Terabit</title>
      <names translatable="no">r:Tbit_c</names>
      <part>
        <unit>bit</unit>
        <prefix>12</prefix>
        <exponent>1</exponent>
      </part>
    </unit>
    <unit type="composite">
      <title>Petabit</title>
      <names translatable="no">r:Pbit_c</names>
      <part>
        <unit>bit</unit>
        <prefix>15</prefix>
        <exponent>1</exponent>
      </part>
    </unit>
    <unit type="composite">
      <title>Kibibit</title>
      <names translatable="no">r:Kibit_c</names>
      <part>
        <unit>bit</unit>
        <prefix type="binary">10</prefix>
        <exponent>1</exponent>
      </part>
    </unit>
    <unit type="composite">
      <title>Mebibit</title>
      <names translatable="no">r:Mibit_c</names>
      <part>
        <unit>bit</unit>
        <prefix type="binary">20</prefix>
        <exponent>1</exponent>
      </part>
    </unit>
    <unit type="composite">
      <title>Gibibit</title>
      <names translatable="no">r:Gibit_c</names>
      <part>
        <unit>bit</unit>
        <prefix type="binary">30</prefix>
        <exponent>1</exponent>
      </part>
    </unit>
  </category>
  <category>
    <title>Typography</title>
    <unit type="alias">
      <title>PostScript Point (DTP)</title>
      <description>The PostScript point, or desktop publishing point, is the screen-independent typographic unit commonly used in computer software and for digital printing. It is known as the big point (bp) in TeX.</description>
      <names>ar:pt,a:pts,point,p:points,as:bp_tex,ao:tex_bp</names>
      <base>
        <unit>in</unit>
        <relation>1/72</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>TeX Point</title>
      <names>r:tex_point,as:pt_TeX,ao:tex_pt,p:tex_points</names>
      <base>
        <unit>in</unit>
        <relation>1/72.27</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>TeX Scaled Point</title>
      <names>r:tex_scaled_point,as:sp_TeX,ao:tex_sp,p:tex_scaled_points</names>
      <base>
        <unit>tex_point</unit>
        <relation>1/65536</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>PostScript Pica</title>
      <names>r:pica,p:picas</names>
      <base>
        <unit>pt</unit>
        <relation>12</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>Twip</title>
      <names>r:twip,p:twips</names>
      <base>
        <unit>pt</unit>
        <relation>1/20</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>Agate</title>
      <names>r:agate,p:agates</names>
      <base>
        <unit>pt</unit>
        <relation>5.5</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>Johnson Pica</title>
      <names>johnson_pica,ro:ata_pica,po:ata_picas</names>
      <base>
        <unit>in</unit>
        <relation>0.166</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>American Point</title>
      <names>US_point,ro:ata_point,as:pt_US,ao:ata_pt,p:US_points,po:ata_points</names>
      <base>
        <unit>ata_pica</unit>
        <relation>1/12</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>New Didot Point</title>
      <names>r:new_didot</names>
      <base>
        <unit>m</unit>
        <relation>0.000375</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>Didot Point</title>
      <names>r:didot,a:dd</names>
      <base>
        <unit>pouce</unit>
        <relation>1/72</relation>
        <exponent>1</exponent>
      </base>
    </unit>
    <unit type="alias">
      <title>Cicero</title>
      <names>r:cicero</names>
      <base>
        <unit>didot</unit>
        <relation>12</relation>
        <exponent>1</exponent>
      </base>
    </unit>
  </category>
</QALCULATE>
