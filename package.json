{
  "private": true,
  "scripts": {
    "serve": "npm run build:web && node server.mjs",
    "build": "docker run --rm -v $PWD:/project -w /project qalcwasm bash build.sh",
    "build:web": "esbuild web/terminal.js --bundle --format=esm --outfile=web/app.js --loader:.css=css && esbuild web/terminal.worker.js --bundle --format=esm --outfile=web/worker.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
